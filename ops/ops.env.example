# Copy to ops.env beside this file. Never commit the real values.
#
# Read only by healthcheck.sh, to send an alert when something is wrong.
# Without it the health check still works and still exits non-zero — it just
# writes to health.log and tells nobody. That is a deliberate degrade, not an
# oversight, but it does mean nobody finds out until they look.

# https://resend.com/api-keys
RESEND_API_KEY=
ALERT_EMAIL=kev.oue@gmail.com

# Must be a domain verified in Resend. onboarding@resend.dev works without
# verifying anything, but only delivers to the address that owns the account.
ALERT_FROM=onboarding@resend.dev
