{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // NodeNext, not bundler: this compiles to real Node ESM that runs directly
    // from dist/. Every relative import already carries its .js extension.
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "src",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "exactOptionalPropertyTypes": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
