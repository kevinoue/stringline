# Copy to .env on the NAS. Never commit the real values.

# openssl rand -base64 32
JWT_SECRET=replace-me
POSTGRES_PASSWORD=replace-me

# Where the API is mounted. Change this and the Caddy block together when
# Stringline moves off kevinoue.com to its own domain.
BASE_PATH=/stringline/api
CORS_ORIGIN=https://kevinoue.com

# ── Optional: email ─────────────────────────────────────────────────────────
# Leave these empty and Stringline still works. Owners can reset a teammate's
# password directly, and invites come back as a code and a link to pass on
# yourself. Only self-service "forgot password" needs mail, and it hides itself
# when this is unset rather than failing.
#
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Where invite and reset links point. Must match how people reach the app.
PUBLIC_URL=https://kevinoue.com/stringline
