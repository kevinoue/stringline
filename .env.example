# Copy to .env on the NAS. Never commit the real values.

# openssl rand -base64 32
JWT_SECRET=replace-me
POSTGRES_PASSWORD=replace-me

# Where the API is mounted. Change this and the Caddy block together when
# Stringline moves off kevinoue.com to its own domain.
BASE_PATH=/stringline/api
CORS_ORIGIN=https://kevinoue.com

# ── Optional: email ─────────────────────────────────────────────────────────
# Leave all of this empty and Stringline still works. Owners can reset a
# teammate's password directly, and invites come back as a code and a link to
# pass on yourself. Only self-service "forgot password" needs mail, and it
# hides itself when this is unset rather than offering a button that fails.
#
# Full instructions, including how to get an app password: ops/EMAIL.md

# An ordinary mailbox — a Gmail or iCloud account. The simplest option.
# SMTP_PASS must be an APP PASSWORD, never the account password: both Google
# and Apple require two-factor before issuing one, and it is revocable on its
# own without touching the rest of the account.
SMTP_PRESET=                  # gmail | icloud | fastmail, or leave blank and set SMTP_HOST
SMTP_USER=
SMTP_PASS=
# Optional. Defaults to SMTP_USER, which is deliberate — Gmail rewrites a From
# address it does not own, so setting it to something unverified gets you a
# header that does not match what was sent.
SMTP_FROM=

# Or set these directly for any other provider. Do not set SMTP_SECURE: it is
# inferred from the port, and 465 (TLS from the first byte) and 587 (STARTTLS)
# are not interchangeable — mismatching them hangs rather than erroring.
# SMTP_HOST=
# SMTP_PORT=

# Or Resend, if that is what you already use. SMTP wins if both are set.
# https://resend.com/api-keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Where invite and reset links point. Must match how people reach the app.
PUBLIC_URL=https://kevinoue.com/stringline

# ── Optional: tuning the login controls ─────────────────────────────────────
# Defaults are sensible; these exist because a test run trips production
# figures in seconds. Do not raise them on a public instance.
# AUTH_RATE_LIMIT=20            # per IP per 15 min, on login/signup/reset
# INVITE_RATE_LIMIT=60          # per IP per 15 min, on redeeming an invite
# LOGIN_FAILURES_BEFORE_LOCK=5  # per account per 15 min
# LOGIN_SPRAY_THRESHOLD=10      # distinct accounts failed from one IP
